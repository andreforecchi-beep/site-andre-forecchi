---
// Galeria em colunas (aceita fotos em pé e deitadas). Legenda é opcional:
// fotos sem legenda aparecem limpas, e a legenda pode ser preenchida depois.
interface Foto { src: string; legenda?: string; credito?: string; alt?: string }
interface Props { fotos: Foto[]; colunas?: number }
const { fotos, colunas = 3 } = Astro.props;
---
<div class="galeria" style={`--cols:${colunas}`}>
  {fotos.map((f) => (
    <figure class="galeria__item">
      <a href={f.src} target="_blank" rel="noopener">
        <img src={f.src} alt={f.alt || f.legenda || ''} loading="lazy" />
      </a>
      {(f.legenda || f.credito) && (
        <figcaption>{f.legenda}{f.credito && `${f.legenda ? '. ' : ''}Foto: ${f.credito}`}</figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .galeria { columns: var(--cols) 240px; column-gap: 1rem; }
  .galeria__item { break-inside: avoid; margin: 0 0 1rem; }
  .galeria__item img { width: 100%; border-radius: 10px; transition: opacity 0.2s; }
  .galeria__item a:hover img { opacity: 0.85; }
  .galeria__item figcaption { font-size: 0.85rem; margin-top: 0.4rem; line-height: 1.4; opacity: 0.85; }
  :global(.secao--ouro) .galeria__item figcaption {
    opacity: 1; background: var(--branco); color: var(--preto); padding: 0.3rem 0.5rem; border-radius: 6px; display: inline-block;
  }
</style>
