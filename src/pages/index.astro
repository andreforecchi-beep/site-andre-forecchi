---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import CartaoObra from '../components/CartaoObra.astro';
import Video from '../components/Video.astro';
import Estrada from '../components/Estrada.astro';
import { numeros, artista } from '../data/artista';
import { obras } from '../data/obras';

// Ordem dos destaques: o homem-banda vem primeiro (foco do site, pedido de André em 23/11/2026).
const ordemDestaques = ['homem-banda-um-manifesto', 'mphb', 'corpoar', 'homem-banda-a-formacao', 'capixaba-eu', 'nos-de-nos-dois'];
const destaques = ordemDestaques.map((s) => obras.find((o) => o.slug === s)!).filter(Boolean);

const eixos = [
  { href: '/homem-banda', titulo: 'Homem-Banda', texto: 'O corpo como orquestra: a linguagem central da pesquisa.' },
  { href: '/artista', titulo: 'O Artista', texto: 'Quem é André Forecchi e os princípios que atravessam o trabalho.' },
  { href: '/trajetoria', titulo: 'Trajetória', texto: 'Seis anos de estrada na Kombi Djanira pela América Latina.' },
  { href: '/teatro', titulo: 'Teatro', texto: 'Espetáculos de rua e teatro documental.' },
  { href: '/audiovisual', titulo: 'Audiovisual', texto: 'Documentários e webséries.' },
  { href: '/cine-bandolero', titulo: 'Cine Bandolero', texto: 'Cineclube itinerante desde 2017.' },
  { href: '/musica', titulo: 'Música', texto: 'MPHB e podcasts.' },
  { href: '/acervo', titulo: 'Acervo', texto: 'Todas as obras, formações, livros e jogos em um só lugar.' },
];
---
<Base>
  <!-- Capa: mesma composição da capa do portfólio -->
  <section class="capa">
    <div class="capa__texto container">
      <h1 class="sr-only">André Forecchi</h1>
      <Logo largura="min(640px, 86vw)" />
      <p class="capa__linha">Homem-banda · Artista multidisciplinar · Espírito Santo</p>
      <ul class="etiquetas etiquetas--cheias capa__tags">
        <li>Homem-banda</li><li>Teatro</li><li>Audiovisual</li><li>Cineclube</li><li>Produção cultural</li>
      </ul>
      <p class="capa__redes">
        <a href={`https://www.instagram.com/${artista.instagram}/`} target="_blank" rel="noopener">@{artista.instagram}</a>
        <span aria-hidden="true">·</span>
        <a href={`https://www.instagram.com/${artista.instagramColetivo}/`} target="_blank" rel="noopener">@{artista.instagramColetivo}</a>
      </p>
    </div>
    <img class="capa__plateia" src="/img/marca/plateia.webp" alt="" width="1600" height="379" />
  </section>

  <!-- Homem-banda: foco do site -->
  <section class="secao secao--preto">
    <div class="container duas-colunas">
      <div>
        <span class="rotulo">Eixo central da pesquisa</span>
        <h2 class="titulo-secao"><span class="pilula pilula--ouro">Homem-Banda</span></h2>
        <p class="lead">
          Saxofone, bumbo, caixa, hi-hat, pratos, tamborins e voz, tocados ao mesmo tempo por cordas, roldanas e engenhocas, sem
          tecnologia.
        </p>
        <p>
          A pesquisa começou de forma autodidata, em 2020, durante a vida na estrada, e passou por cinco meses de estudo com
          Santiago Moreno, em Nancy, na França. Hoje vira show, espetáculo, oficina e a primeira formação em homem e mulher-banda do mundo.
        </p>
        <div class="botoes">
          <a class="botao botao--contorno" href="/homem-banda">O corpo como orquestra →</a>
          <a class="botao botao--contorno" href="/obras/mphb">Show MPHB →</a>
        </div>
      </div>
      <Video video={{ titulo: 'Mas que nada, no festival Chalon dans la Rue (França, 2023)', youtube: 'Iayk4bIzvtM' }} />
    </div>
    <div class="container mt-3">
      <div class="numeros hb-num">
        <div class="numero"><strong>5 meses</strong><span>de estudo com Santiago Moreno, na França</span></div>
        <div class="numero"><strong>128</strong><span>inscritos na primeira formação em homem e mulher-banda do mundo</span></div>
        <div class="numero"><strong>4 países</strong><span>na formação: Brasil, Itália, Austrália e EUA</span></div>
        <div class="numero"><strong>7 países</strong><span>com homem-banda na rua: Brasil, Peru, Equador, Colômbia, Venezuela, França e Irlanda</span></div>
      </div>
    </div>
  </section>

  <!-- Apresentação -->
  <section class="secao secao--branco">
    <div class="container duas-colunas">
      <img src="/img/marca/artista-silhueta.webp" alt="Ilustração: silhueta de André tocando saxofone com bumbo e pratos nas costas, sobre linhas douradas" width="901" height="469" loading="lazy" />
      <div>
        <h2 class="titulo-secao"><span class="pilula">O Artista</span></h2>
        <p class="lead">
          Natural de Aracruz (ES), nascido no dia de Iemanjá, André Forecchi entendeu cedo a arte como um campo integral e diverso.
          Hoje atua como escritor, compositor, produtor cultural e audiovisual, ator, cineclubista, oficineiro, multi-instrumentista
          e, claro, homem-banda.
        </p>
        <a class="botao" href="/artista">Conhecer o artista →</a>
      </div>
    </div>
  </section>

  <!-- Números -->
  <section class="secao secao--ouro gotas">
    <div class="container">
      <span class="rotulo">A estrada em números</span>
      <div class="numeros">
        {numeros.map((n) => (
          <div class="numero"><strong>{n.valor}</strong><span class="marca-texto">{n.rotulo}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Obras em destaque -->
  <section class="secao">
    <div class="container">
      <h2 class="titulo-secao"><span class="pilula">Obras em destaque</span></h2>
      <div class="grade grade-3">
        {destaques.map((o) => <CartaoObra obra={o} />)}
      </div>
      <p class="mt-2"><a class="botao botao--contorno" href="/acervo">Ver o acervo completo →</a></p>
    </div>
  </section>

  <!-- Djanira -->
  <section class="secao secao--ouro">
    <div class="container duas-colunas">
      <img src="/img/marca/djanira-mockup.webp" alt="A Kombi Djanira adesivada com a identidade visual do artista" width="1076" height="718" loading="lazy" class="arredondada" />
      <div>
        <h2 class="titulo-secao"><span class="pilula">CCIDjanira</span></h2>
        <p><span class="marca-texto">
          Djanira é a Kombi 2003 que foi casa dos gêmeos André e Davi por seis anos. Com o fim da vida itinerante, em 2023,
          virou o Centro de Cultura Itinerante Djanira: transporte, logística e cenário dos espetáculos e do Cine Bandolero.
        </span></p>
        <a class="botao mt-1" href="/trajetoria#djanira">A história da Djanira →</a>
      </div>
    </div>
  </section>

  <Estrada />

  <!-- Navegue -->
  <section class="secao secao--branco">
    <div class="container">
      <h2 class="titulo-secao"><span class="pilula">Navegue</span></h2>
      <div class="grade grade-4">
        {eixos.map((e) => (
          <a class="cartao eixo" href={e.href}>
            <div class="cartao__corpo">
              <h3 class="cartao__titulo">{e.titulo}</h3>
              <p class="cartao__texto">{e.texto}</p>
              <span class="cartao__seta">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .capa { background: var(--branco); text-align: center; padding-top: clamp(3.5rem, 10vw, 7rem); overflow: hidden; }
  .capa__texto { display: flex; flex-direction: column; align-items: center; }
  .capa__linha { letter-spacing: 0.45em; text-transform: uppercase; font-size: clamp(0.75rem, 1.6vw, 1rem); margin: 1.5rem 0 1.25rem; padding-left: 0.45em; }
  .capa__tags { justify-content: center; }
  .capa__redes { margin: 1.1rem 0 0; font-weight: 700; display: flex; gap: 0.6rem; justify-content: center; }
  .capa__redes a { text-decoration: none; border-bottom: 2px solid var(--ouro); }
  .capa__redes a:hover { background: var(--ouro); }
  .capa__plateia { width: 100%; min-width: 900px; margin: clamp(2rem, 6vw, 4rem) auto 0; position: relative; left: 50%; transform: translateX(-50%); }
  .arredondada { border-radius: var(--raio); }
  .hb-num { color: var(--ouro); }
  .hb-num span { color: var(--branco); }
  .eixo { border-color: var(--preto); }
  .eixo .cartao__titulo { font-size: 1.15rem; }
  .eixo:hover { background: var(--ouro); }
  .eixo:hover .cartao__texto { color: var(--preto); }
</style>
